<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculatrice.MainPage"
             BackgroundColor="#1E1E1E">

    <ContentPage.Resources>
        <!-- Style commun à tous les boutons -->
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BackgroundColor" Value="#3A3A3C" />
            <Setter Property="TextColor" Value="White" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="12">

        <!-- Zone d'affichage : expression en haut, valeur courante en dessous -->
        <VerticalStackLayout Grid.Row="0" Spacing="4" Padding="8,24,8,8">
            <Label x:Name="LabelExpression"
                   Text=""
                   FontSize="20"
                   TextColor="#9E9E9E"
                   HorizontalTextAlignment="End" />
            <Label x:Name="LabelAffichage"
                   Text="0"
                   FontSize="56"
                   TextColor="White"
                   HorizontalTextAlignment="End"
                   LineBreakMode="TailTruncation" />
        </VerticalStackLayout>

        <!-- Clavier : 5 lignes x 4 colonnes -->
        <Grid Grid.Row="1"
              RowDefinitions="*,*,*,*,*"
              ColumnDefinitions="*,*,*,*"
              RowSpacing="8"
              ColumnSpacing="8">

            <!-- Ligne 0 -->
            <Button Grid.Row="0" Grid.Column="0" Text="C" BackgroundColor="#A5A5A5" TextColor="Black" Clicked="OnEffacerClicked" />
            <Button Grid.Row="0" Grid.Column="1" Text="⌫" BackgroundColor="#A5A5A5" TextColor="Black" Clicked="OnSupprimerClicked" />
            <Button Grid.Row="0" Grid.Column="2" Text="±" BackgroundColor="#A5A5A5" TextColor="Black" Clicked="OnSigneClicked" />
            <Button Grid.Row="0" Grid.Column="3" Text="÷" BackgroundColor="#FF9500" Clicked="OnOperateurClicked" />

            <!-- Ligne 1 -->
            <Button Grid.Row="1" Grid.Column="0" Text="7" Clicked="OnChiffreClicked" />
            <Button Grid.Row="1" Grid.Column="1" Text="8" Clicked="OnChiffreClicked" />
            <Button Grid.Row="1" Grid.Column="2" Text="9" Clicked="OnChiffreClicked" />
            <Button Grid.Row="1" Grid.Column="3" Text="×" BackgroundColor="#FF9500" Clicked="OnOperateurClicked" />

            <!-- Ligne 2 -->
            <Button Grid.Row="2" Grid.Column="0" Text="4" Clicked="OnChiffreClicked" />
            <Button Grid.Row="2" Grid.Column="1" Text="5" Clicked="OnChiffreClicked" />
            <Button Grid.Row="2" Grid.Column="2" Text="6" Clicked="OnChiffreClicked" />
            <Button Grid.Row="2" Grid.Column="3" Text="-" BackgroundColor="#FF9500" Clicked="OnOperateurClicked" />

            <!-- Ligne 3 -->
            <Button Grid.Row="3" Grid.Column="0" Text="1" Clicked="OnChiffreClicked" />
            <Button Grid.Row="3" Grid.Column="1" Text="2" Clicked="OnChiffreClicked" />
            <Button Grid.Row="3" Grid.Column="2" Text="3" Clicked="OnChiffreClicked" />
            <Button Grid.Row="3" Grid.Column="3" Text="+" BackgroundColor="#FF9500" Clicked="OnOperateurClicked" />

            <!-- Ligne 4 : le 0 occupe deux colonnes -->
            <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="0" Clicked="OnChiffreClicked" />
            <Button Grid.Row="4" Grid.Column="2" Text="," Clicked="OnVirguleClicked" />
            <Button Grid.Row="4" Grid.Column="3" Text="=" BackgroundColor="#FF9500" Clicked="OnEgalClicked" />
        </Grid>
    </Grid>
</ContentPage>